{
  "name": "@scanflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/src/main.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@scalar/express-api-reference": "^0.10.22",
    "@scanflow/contracts": "workspace:*",
    "@scanflow/scheduling-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "luxon": "3.7.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@scanflow/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.5",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.3",
    "supertest": "7.3.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.15",
    "vitest": "4.1.10"
  }
}
