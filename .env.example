# Copy to .env. Never commit .env — it is gitignored and push protection is on.

# --- Postgres (consumed by docker-compose and by the api) ---
POSTGRES_USER=scanflow
POSTGRES_PASSWORD=scanflow
POSTGRES_DB=scanflow
POSTGRES_PORT=5432

# The api connects through this. Matches the credentials above.
DATABASE_URL=postgres://scanflow:scanflow@localhost:5432/scanflow

# --- API ---
PORT=3000
# Stable id written by `pnpm db:seed`. Multi-clinic tenancy arrives later.
CLINIC_ID=11111111-1111-4111-8111-111111111111
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Auth (M6). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ---
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Optional override for seeded demo users (default ScanFlow!Demo1)
# SEED_USER_PASSWORD=

# --- Redis (SSE fan-out, wired in M6) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Web ---
VITE_API_URL=http://localhost:3000
