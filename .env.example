# Copy to .env. Never commit .env — it is gitignored and push protection is on.

# --- Postgres (consumed by docker-compose and by the api) ---
POSTGRES_USER=scanflow
POSTGRES_PASSWORD=scanflow
POSTGRES_DB=scanflow
POSTGRES_PORT=5432

# The api connects through this. Matches the credentials above.
DATABASE_URL=postgres://scanflow:scanflow@localhost:5432/scanflow

# --- Redis (SSE fan-out, wired in M6) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Web ---
VITE_API_URL=http://localhost:3000
